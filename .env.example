# Copy this file to .env and fill in your values.
# cp .env.example .env

# OpenAI API key — required for Live Mode.
# Obtain one at https://platform.openai.com/api-keys
# Leave blank (or omit) to run in Sample Mode.
OPENAI_API_KEY=

# HTTP port the server listens on. Defaults to 3000.
PORT=3000

# Force Sample Mode even when OPENAI_API_KEY is set.
# Set to "true" to use fixture responses instead of calling the API.
SAMPLE_MODE=false
